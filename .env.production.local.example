# ==============================================================================
# Production secrets — copy this file to .env.production.local and fill values
# This file is tracked in git (no secrets). .env.production.local is gitignored.
# ==============================================================================

# ==============================================================================
# ISR & CACHE REVALIDATION
# ==============================================================================
# Global fallback token for on-demand revalidation API (/api/revalidate)
# Generate a strong random token: openssl rand -base64 32
# Journal-specific tokens can be set via REVALIDATION_TOKEN_<JOURNAL_CODE>
REVALIDATION_SECRET=""

# ==============================================================================
# VALKEY / REDIS DISTRIBUTED CACHE
# ==============================================================================

# Enable distributed cache (false for local dev, true in production)
VALKEY_ENABLED=false

# Sentinel hosts (comma-separated host:port)
VALKEY_SENTINEL_HOSTS="sentinel-1:26379,sentinel-2:26379,sentinel-3:26379"

# Sentinel master group name
VALKEY_MASTER_NAME=mymaster

# Valkey ACL username and password
VALKEY_USERNAME=""
VALKEY_PASSWORD=""

# Sentinel ACL username and password (can differ from node credentials)
VALKEY_SENTINEL_USERNAME=""
VALKEY_SENTINEL_PASSWORD=""

# Key prefix for Next.js cache entries
VALKEY_KEY_PREFIX="next:"

# Circuit breaker: errors before switching to in-memory fallback (default: 5)
VALKEY_CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker: seconds before probing Valkey recovery (default: 30)
VALKEY_CIRCUIT_BREAKER_PROBE_INTERVAL=30

# ==============================================================================
# CACHE TTL (time-to-live, in seconds)
# Controls the maximum age of cached fetch responses before time-based revalidation.
# Set to "false" to disable time-based revalidation (on-demand only via revalidateTag).
# Omit a variable to use the default: 3600 (1 hour).
# ==============================================================================

# News articles (default: 3600)
CACHE_TTL_NEWS=3600

# Volumes and issues (default: 3600)
CACHE_TTL_VOLUMES=3600

# Published articles (default: 3600)
CACHE_TTL_ARTICLES=3600

# Static editorial pages: about, credits, for-reviewers, acknowledgements, etc. (default: 3600)
CACHE_TTL_PAGES=3600

# Statistics and journal metrics (default: 3600)
CACHE_TTL_STATISTICS=3600

# Board members (default: 3600)
CACHE_TTL_MEMBERS=3600

# Sections (default: 3600)
CACHE_TTL_SECTIONS=3600

# ==============================================================================
# PDF CACHE (NFS disk cache for /api/pdf-proxy)
# See docs/PDF_CACHE_STRATEGY.md for the full design and rollout phases.
# Requires VALKEY_ENABLED=true above — Valkey is the only channel between the
# app (reader) and the pdf-cache-worker systemd service (the only writer).
# ==============================================================================

# Master switch — false is a complete no-op (no fs/Valkey calls at all).
# Rollback at any time is: set this back to false and restart.
PDF_CACHE_ENABLED=false

# "fallback" (recommended default): serve upstream first, only fall back to
# the cache when upstream fails. "systematic": consult the cache first for
# latency too — only switch to this once a measured hit rate justifies it
# (see docs/PDF_CACHE_STRATEGY.md §10).
PDF_CACHE_MODE=fallback

# Required whenever PDF_CACHE_ENABLED=true (must match ^[a-z0-9-]{2,20}$).
# Missing/invalid disables the cache silently (fails closed) rather than
# guessing the environment.
EPI_ENV=prod

# Cache root prefix — mirrors Nginx's $epi_data_root. Leave at the default in
# production; only override for local/CI testing (e.g. /tmp/pdf-cache-test).
PDF_CACHE_BASE_DIR=/data/epi

# Subdirectory name under ${PDF_CACHE_BASE_DIR}/${EPI_ENV}/ — not a path.
PDF_CACHE_ROOT=pdf-cache

# Staleness threshold in "systematic" mode, in seconds (default: 15552000, 180 days)
PDF_CACHE_MAX_AGE_SECONDS=15552000

# TTL of the Valkey dedup lock before a populate/refresh job can be
# re-published for the same PDF (default: 3600). This is what prevents a
# popular PDF from doubling upstream traffic instead of reducing it.
PDF_CACHE_ENQUEUE_TTL_SECONDS=3600

# Valkey pub/sub channel used to ask the worker to populate/refresh an entry.
PDF_CACHE_CHANNEL=pdf-cache-populate

# --- Worker-only variables (read by scripts/pdf-cache-worker.mjs, set in
#     /etc/episciences/worker.env — see docs/PDF_CACHE_STRATEGY.md §10) ---

# Delete entries older than this many days, by fetchedAt (default: 365)
PDF_CACHE_RETENTION_DAYS=365

# Periodic retention/orphan sweep, running inside the worker itself — no
# separate systemd timer, so there is never a second writer (default: true)
PDF_CACHE_SWEEP_ENABLED=true

# Time to sweep the whole cache tree once (default: 24)
PDF_CACHE_SWEEP_INTERVAL_HOURS=24

# Per-file size cap, in bytes (default: 104857600, 100MB)
PDF_CACHE_MAX_BYTES=104857600

# Cache-wide size cap, in bytes; 0 = unlimited (default: 0). Enforced once per
# full sweep cycle via oldest-first eviction.
PDF_CACHE_MAX_TOTAL_BYTES=0

# Refuse new writes when free space on the cache filesystem drops below this
# percentage (default: 10) — protects the shared NFS mount from filling up.
PDF_CACHE_MIN_FREE_PERCENT=10

# Upstream fetch timeout for the worker, in ms (default: 20000)
PDF_CACHE_FETCH_TIMEOUT_MS=20000

# Max populate/refresh jobs the worker processes concurrently (default: 4)
PDF_CACHE_WORKER_CONCURRENCY=4

# Bounded in-memory job queue — extra jobs beyond this are dropped (and
# logged), never buffered indefinitely (default: 500)
PDF_CACHE_QUEUE_MAX=500
