# ==============================================================================
# Production secrets — copy this file to .env.preprod.local and fill values
# This file is tracked in git (no secrets). .env.preprod.local is gitignored.
# ==============================================================================

# ==============================================================================
# ISR & CACHE REVALIDATION
# ==============================================================================
# Global fallback token for on-demand revalidation API (/api/revalidate)
# Generate a strong random token: openssl rand -base64 32
# Journal-specific tokens can be set via REVALIDATION_TOKEN_<JOURNAL_CODE>
REVALIDATION_SECRET=""

# ==============================================================================
# VALKEY / REDIS DISTRIBUTED CACHE
# ==============================================================================

# Enable distributed cache (false for local dev, true in production)
VALKEY_ENABLED=false

# Sentinel hosts (comma-separated host:port)
VALKEY_SENTINEL_HOSTS="sentinel-1:26379,sentinel-2:26379,sentinel-3:26379"

# Sentinel master group name
VALKEY_MASTER_NAME=mymaster

# Valkey ACL username and password
VALKEY_USERNAME=""
VALKEY_PASSWORD=""

# Sentinel ACL username and password (can differ from node credentials)
VALKEY_SENTINEL_USERNAME=""
VALKEY_SENTINEL_PASSWORD=""

# Key prefix for Next.js cache entries
VALKEY_KEY_PREFIX="next:"

# Circuit breaker: errors before switching to in-memory fallback (default: 5)
VALKEY_CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker: seconds before probing Valkey recovery (default: 30)
VALKEY_CIRCUIT_BREAKER_PROBE_INTERVAL=30

# ==============================================================================
# CACHE TTL (time-to-live, in seconds)
# Controls the maximum age of cached fetch responses before time-based revalidation.
# Set to "false" to disable time-based revalidation (on-demand only via revalidateTag).
# Omit a variable to use the default: 3600 (1 hour).
# ==============================================================================

# News articles (default: 3600)
CACHE_TTL_NEWS=3600

# Volumes and issues (default: 3600)
CACHE_TTL_VOLUMES=3600

# Published articles (default: 3600)
CACHE_TTL_ARTICLES=3600

# Static editorial pages: about, credits, for-reviewers, acknowledgements, etc. (default: 3600)
CACHE_TTL_PAGES=3600

# Statistics and journal metrics (default: 3600)
CACHE_TTL_STATISTICS=3600

# Board members (default: 3600)
CACHE_TTL_MEMBERS=3600

# Sections (default: 3600)
CACHE_TTL_SECTIONS=3600

# ==============================================================================
# PDF CACHE (NFS disk cache for /api/pdf-proxy)
# See docs/PDF_CACHE_STRATEGY.md for the full design and rollout phases.
#
# Single place for every PDF cache setting, app AND worker: the worker runs
# from the release directory and reads this same file (deployed as .env.local)
# with @next/env, like Next.js. Do not copy these into
# /etc/episciences/worker.env: a value there overrides this file for the
# worker only. The deploy restarts both the app and the worker.
#
# Requires VALKEY_ENABLED=true above: Valkey is the only channel between the
# app (reader) and the pdf-cache-worker systemd service (the only writer).
# ==============================================================================

# --- Per-environment settings: the only ones to set ---

# Master switch, read by the app only (the worker processes whatever the app
# publishes). false is a complete no-op (no fs/Valkey calls at all).
# Rollback at any time is: set this back to false and restart the app.
PDF_CACHE_ENABLED=false

# "fallback" (recommended default): serve upstream first, only fall back to
# the cache when upstream fails. "systematic": consult the cache first for
# latency too; only switch once a measured hit rate justifies it
# (see docs/PDF_CACHE_STRATEGY.md section 10).
PDF_CACHE_MODE=fallback

# Required whenever PDF_CACHE_ENABLED=true (must match ^[a-z0-9-]{2,20}$).
# Separates the cache directories of each environment on the shared NFS mount,
# which is why it must never go in the tracked .env. Missing/invalid disables
# the cache (app) or stops the worker, rather than guessing the environment.
EPI_ENV=preprod

# --- Tuning: defaults shown, uncomment only to change one ---

# Cache root prefix, mirrors Nginx's $epi_data_root. Only override for
# local/CI testing (e.g. /tmp/pdf-cache-test).
# PDF_CACHE_BASE_DIR=/data/epi

# Subdirectory name under ${PDF_CACHE_BASE_DIR}/${EPI_ENV}/, not a path.
# PDF_CACHE_ROOT=pdf-cache

# Valkey pub/sub channel the app publishes on and the worker subscribes to.
# PDF_CACHE_CHANNEL=pdf-cache-populate

# Staleness threshold, in seconds (default: 15552000, 180 days). App: in
# "systematic" mode, an older entry is served and a refresh is requested.
# Worker: a populate job for a younger entry is skipped.
# PDF_CACHE_MAX_AGE_SECONDS=15552000

# App: timeout of each cache read (sidecar read, open, fstat), in ms. On
# timeout the request is a miss and cache reads are skipped for 30s. The NFS
# mount must still be "soft" (see docs/PDF_CACHE_STRATEGY.md section 9).
# PDF_CACHE_READ_TIMEOUT_MS=2000

# App: TTL of the Valkey dedup lock before a populate/refresh job can be
# re-published for the same PDF, in seconds. This is what prevents a popular
# PDF from doubling upstream traffic instead of reducing it.
# PDF_CACHE_ENQUEUE_TTL_SECONDS=3600

# Worker: delete entries older than this many days, by fetchedAt. 0 = never.
# Off on purpose: published PDFs almost never change (corrections go through
# the pdfUrl invalidation of /api/revalidate), and an entry whose upstream is
# unavailable keeps an old fetchedAt, so age-based deletion would remove the
# very copy the fallback mode serves. See docs/PDF_CACHE_STRATEGY.md section 6.
# PDF_CACHE_RETENTION_DAYS=0

# Worker: periodic orphan (and optional retention) sweep, running inside the
# worker itself, so there is never a second writer.
# PDF_CACHE_SWEEP_ENABLED=true

# Worker: time to sweep the whole cache tree once, in hours.
# PDF_CACHE_SWEEP_INTERVAL_HOURS=24

# Worker: per-file size cap, in bytes (100MB).
# PDF_CACHE_MAX_BYTES=104857600

# Worker: cache-wide size cap, in bytes; 0 = unlimited. Enforced once per full
# sweep cycle via oldest-first eviction.
# PDF_CACHE_MAX_TOTAL_BYTES=0

# Worker: refuse new writes when free space on the cache filesystem drops
# below this percentage, to protect the shared NFS mount from filling up.
# PDF_CACHE_MIN_FREE_PERCENT=10

# Worker: upstream timeouts, in ms. FETCH_TIMEOUT: wait for the response
# headers. BODY_IDLE_TIMEOUT: longest wait between two body chunks.
# FETCH_MAX_DURATION: cap on a whole download (10 min).
# PDF_CACHE_FETCH_TIMEOUT_MS=20000
# PDF_CACHE_BODY_IDLE_TIMEOUT_MS=20000
# PDF_CACHE_FETCH_MAX_DURATION_MS=600000

# Worker: max populate/refresh jobs processed concurrently.
# PDF_CACHE_WORKER_CONCURRENCY=4

# Worker: bounded in-memory job queue; extra jobs are dropped (and logged),
# never buffered indefinitely.
# PDF_CACHE_QUEUE_MAX=500


# ==============================================================================
# CACHE DIAGNOSTICS
# ==============================================================================

# Enable HIT/MISS/SET logs from the Valkey cache handler.
# Set to "true" to activate, remove or set to "false" to disable.
# Logs appear in Next.js stdout: journalctl -u episciences-next -f | grep CacheHandler
CACHE_DEBUG=true